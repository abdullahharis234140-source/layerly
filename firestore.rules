rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      // Only allow harmless fields from the client. 'pro' must be written by a Cloud Function after receipt verification.
      allow write: if request.auth.uid == uid && !request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['pro_locked']);
    }
  }
}
